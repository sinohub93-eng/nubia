# Nubia environment (copy to .env). Only browser-safe values belong here.
# Project URL: the base URL only, WITHOUT /rest/v1
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable (anon) key. NEVER put the service_role / secret key or the database password in this file.
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Local demo only: when Supabase cannot be reached, show the bundled sample catalogue with a visible notice.
# Leave "false" (or unset) in production so real failures are shown as errors.
VITE_ALLOW_SAMPLE_FALLBACK=false
# Flutterwave PUBLIC key only (FLWPUBK_TEST-... for sandbox). The SECRET key lives only in Supabase Edge Function secrets.
VITE_FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X

# ------------------------------------------------------------------------------------------------
# SERVER-SIDE ONLY. These are Supabase Edge Function secrets, NOT frontend variables.
# Never prefix them with VITE_, never commit real values. Set them with:
#   supabase secrets set NAME=value        (or Dashboard > Edge Functions > Secrets)
# Names shown with placeholders only:
#
#   FLW_SECRET_KEY=
#   FLW_SECRET_HASH=
#   PAYMENT_REDIRECT_URL=https://your-site/#/payment/callback
#
#   RESELLERCLUB_API_KEY=
#   RESELLERCLUB_AUTH_USER_ID=                 # sent as the X-User-Id header (ResellerClub REST API v2)
#   RESELLERCLUB_API_BASE_URL=https://api.sandbox.resellerclub.com/v2   # live: https://api.resellerclub.com/v2
#   RESELLERCLUB_INVOICE_OPTION=NoInvoice      # optional
#   DOMAIN_DEFAULT_NAMESERVERS=ns1.example.com,ns2.example.com          # nameservers given to new domains
#
#   SITE_ACCESS_PROVIDER=manual                # website access connector (only "manual" exists today)
#   CRON_SECRET=                               # header value the scheduler sends to the maintenance function
# ------------------------------------------------------------------------------------------------
